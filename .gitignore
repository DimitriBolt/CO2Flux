# Python cache/artifacts
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/

# Local coordinates/settings differ by machine and operating system.
Sensors_Description/config.toml

# Local secrets (keep templates tracked)
.env
.env.*
!.env.example
!.emv.example

# Versioned full LEO West raw archives and diagnostic working files.
Project_description/sensorDB/Row_data/LEO_West_full/

# Exact-source hydrology checkpoints and temporary build folders stay local.
Project_description/sensorDB/Row_data/LEO_West_hydrology_raw/
Project_description/sensorDB/Row_data/.hydrology-export-*/
Project_description/sensorDB/Row_data/.hydrology-previous-*/

# Large reproducible per-measurement decisions for final stage 0.2 admission.
Project_description/Research_log/data/stage02_final_admission/

# Separate reproducible candidate input; original strict decisions stay intact.
Project_description/Research_log/data/stage02_candidate_selection/

# Oracle temperature snapshots, checkpoints, staging and offline selections.
Project_description/sensorDB/Row_data/LEO_West_temperature_raw/
Project_description/sensorDB/Row_data/.temperature-stage-*/
Project_description/sensorDB/Row_data/.temperature-publish.json*

# Keep the soil-temperature catalogues and provenance on the export machine.
/Project_description/sensorDB/Row_data/LEO_West_Soil_Temperature/channels.csv
/Project_description/sensorDB/Row_data/LEO_West_Soil_Temperature/duplicate_times.csv
/Project_description/sensorDB/Row_data/LEO_West_Soil_Temperature/pilot_coverage.csv
/Project_description/sensorDB/Row_data/LEO_West_Soil_Temperature/provenance.json
